# Gemini API Key (backend only - never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model IDs (fill in the current stable model IDs from Google AI Studio)
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_STT_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# TTS Provider: true = Gemini TTS, false = browser fallback only
USE_GEMINI_TTS=true

# Cloud PostgreSQL connection string (Neon, Supabase, Cloud SQL, etc.)
# Special characters in password MUST be URL-encoded (e.g., @ -> %40)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Frontend base URL — used to generate QR codes
# Local:       http://localhost:3000
# LAN testing: http://192.168.x.x:3000   (your machine's LAN IP)
# Production:  https://your-frontend-domain.vercel.app
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Maximum audio upload size in MB
MAX_AUDIO_MB=10

# Port for uvicorn (used in Dockerfile)
PORT=8000
